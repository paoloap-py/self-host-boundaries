# Each flag breaks exactly one boundary. All default to 1, so a bare `up` breaks all four.
# Set one to 0 to make that boundary healthy and leave the rest broken.
BREAK_ROUTER=1        # boundary 1: the router drops response_format
BREAK_VERSION_PIN=1   # boundary 2: vLLM 0.11.1, which deleted vllm.engine.metrics
BREAK_METRICS=1       # boundary 3: scrape Triton only, miss the two alerting metrics
BREAK_TRACKER=1       # boundary 4: the format tracker assumes the token list only grows
